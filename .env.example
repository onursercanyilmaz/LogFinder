# LogFinder — örnek ortam dosyası (DEĞERSİZ ŞABLON, git'e eklenir).
# Gerçek değerleri .env.local dosyasına yaz (.env.local git'e eklenmez).
# Kurulum: bu dosyayı .env.local adıyla kopyalayıp içini doldur.

# Elasticsearch
ELASTIC_URL=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_PATTERN=
ELASTIC_TIME_FIELD=@timestamp

# Kurumsal AI backend (OpenAI-uyumlu değil, özel şemalı)
AI_BASE_URL=
AI_USERNAME=
AI_NODE_NAME=
AI_BOT=
AI_VERSION=

# Virgülle ayrılmış data view tohumları + zaman alanı
DEFAULT_VIEW_PATTERNS=
DEFAULT_TIME_FIELD=@timestamp
